ARG APP_DIR

FROM node:22-alpine AS builder
ARG APP_DIR
WORKDIR /app
COPY ${APP_DIR}/package*.json ./
RUN npm ci
COPY ${APP_DIR}/ ./
ARG EASY_BPM_ADMIN_API_BASE_URL=""
ARG EASY_BPM_MODELER_API_BASE_URL=""
ARG EASY_BPM_TASK_PORTAL_API_BASE_URL=""
ENV EASY_BPM_ADMIN_API_BASE_URL=${EASY_BPM_ADMIN_API_BASE_URL}
ENV EASY_BPM_MODELER_API_BASE_URL=${EASY_BPM_MODELER_API_BASE_URL}
ENV EASY_BPM_TASK_PORTAL_API_BASE_URL=${EASY_BPM_TASK_PORTAL_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 8080
