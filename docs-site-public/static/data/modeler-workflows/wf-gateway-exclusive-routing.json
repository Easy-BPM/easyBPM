{
  "processId": "wf_gateway_exclusive_routing",
  "metadata": {
    "version": "1.0",
    "purpose": "Exclusive gateway with conditional paths"
  },
  "variables": [
    { "name": "amount", "type": "number", "initialValue": "1500" },
    { "name": "riskLevel", "type": "string", "initialValue": "HIGH" },
    { "name": "decision", "type": "string", "initialValue": "" }
  ],
  "nodes": [
    { "id": "start", "name": "Start", "type": "StartEvent", "position": { "x": 80, "y": 260 }, "next": ["gw_decision"] },
    { "id": "gw_decision", "name": "Decision", "type": "ExclusiveGateway", "position": { "x": 280, "y": 260 }, "next": ["manual_review", "auto_approve"] },
    { "id": "manual_review", "name": "Manual Review", "type": "UserTask", "position": { "x": 500, "y": 180 }, "next": ["end"], "config": { "assignee": "analyst", "inputs": [], "outputs": [ { "source": "static", "sourceValue": "MANUAL", "type": "string", "targetVariable": "decision" } ] } },
    { "id": "auto_approve", "name": "Auto Approve", "type": "ServiceTask", "position": { "x": 500, "y": 340 }, "next": ["end"], "config": { "inputs": [], "outputs": [ { "source": "static", "sourceValue": "AUTO", "type": "string", "targetVariable": "decision" } ] } },
    { "id": "end", "name": "End", "type": "EndEvent", "position": { "x": 740, "y": 260 }, "next": [] }
  ],
  "flows": [
    { "from": "start", "to": "gw_decision", "condition": null },
    { "from": "gw_decision", "to": "manual_review", "condition": "${amount > 1000 || riskLevel == 'HIGH'}" },
    { "from": "gw_decision", "to": "auto_approve", "condition": "${amount <= 1000 && riskLevel != 'HIGH'}" },
    { "from": "manual_review", "to": "end", "condition": null },
    { "from": "auto_approve", "to": "end", "condition": null }
  ]
}
