{
  "processId": "wf_gateway_parallel_sync",
  "metadata": {
    "version": "1.0",
    "purpose": "Parallel split and join"
  },
  "variables": [
    { "name": "customerId", "type": "string", "initialValue": "C-100" },
    { "name": "creditChecked", "type": "boolean", "initialValue": "false" },
    { "name": "kycChecked", "type": "boolean", "initialValue": "false" }
  ],
  "nodes": [
    { "id": "start", "name": "Start", "type": "StartEvent", "position": { "x": 80, "y": 260 }, "next": ["gw_split"] },
    { "id": "gw_split", "name": "Parallel Split", "type": "ParallelGateway", "position": { "x": 250, "y": 260 }, "next": ["credit_task", "kyc_task"] },
    { "id": "credit_task", "name": "Credit Check", "type": "ServiceTask", "position": { "x": 450, "y": 170 }, "next": ["gw_join"], "config": { "inputs": [], "outputs": [ { "source": "static", "sourceValue": "true", "type": "boolean", "targetVariable": "creditChecked" } ] } },
    { "id": "kyc_task", "name": "KYC Check", "type": "ServiceTask", "position": { "x": 450, "y": 350 }, "next": ["gw_join"], "config": { "inputs": [], "outputs": [ { "source": "static", "sourceValue": "true", "type": "boolean", "targetVariable": "kycChecked" } ] } },
    { "id": "gw_join", "name": "Parallel Join", "type": "ParallelGateway", "position": { "x": 650, "y": 260 }, "next": ["end"] },
    { "id": "end", "name": "End", "type": "EndEvent", "position": { "x": 820, "y": 260 }, "next": [] }
  ],
  "flows": [
    { "from": "start", "to": "gw_split", "condition": null },
    { "from": "gw_split", "to": "credit_task", "condition": null },
    { "from": "gw_split", "to": "kyc_task", "condition": null },
    { "from": "credit_task", "to": "gw_join", "condition": null },
    { "from": "kyc_task", "to": "gw_join", "condition": null },
    { "from": "gw_join", "to": "end", "condition": null }
  ]
}
