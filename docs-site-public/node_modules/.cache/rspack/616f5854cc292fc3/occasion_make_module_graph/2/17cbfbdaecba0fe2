            if (product >= MAX_TERMS) {
                if (product > MAX_TERMS) {
                    const max = Math.floor(MAX_TERMS / termsProduct);
                    tokenTerm.splice(max, tokenTerm.length - max);
                    termsProduct = max * termsProduct;
                } else {
                    termsProduct = product;
                }
                if (termsProduct > HALF_MAX_TERMS) {
                    overflowed = true;
                }
            } else {
                termsProduct = product;
            }
        }
