        if (aPageIndex === -1) {
            aPageIndex = a.index;
        }
        if (bPageIndex === -1) {
            bPageIndex = b.index;
        }
        if (aPageIndex === bPageIndex) {
            const diff = (b.type === 0 ? 1 : 0) - (a.type === 0 ? 1 : 0);
            return diff === 0 ? a.index - b.index : diff;
        }
        return aPageIndex - bPageIndex;
