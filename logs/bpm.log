    END IF;

    -- Drop legacy `name` column if present
    IF EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_name='process_definition' AND column_name='name'
    ) THEN
        EXECUTE 'ALTER TABLE process_definition DROP COLUMN name';
    END IF;
END$$

