{
  "processId": "qa_user_task_forms",
  "processName": "QA User Tasks and Forms",
  "metadata": {
    "version": "1.0",
    "purpose": "Modeler and runtime QA for user tasks, formId references, task input/output mappings, and exclusive approval routing."
  },
  "variables": [
    { "name": "requestTitle", "type": "string", "initialValue": "Laptop replacement" },
    { "name": "amount", "type": "number", "initialValue": "1250" },
    { "name": "priority", "type": "string", "initialValue": "NORMAL" },
    { "name": "approved", "type": "boolean", "initialValue": "false" },
    { "name": "managerComment", "type": "string", "initialValue": "" },
    { "name": "financeApproved", "type": "boolean", "initialValue": "false" },
    { "name": "financeComment", "type": "string", "initialValue": "" },
    { "name": "paymentMethod", "type": "string", "initialValue": "" },
    { "name": "supportingDocument", "type": "string", "initialValue": "" }
  ],
  "nodes": [
    {
      "id": "start",
      "name": "Start QA Request",
      "type": "StartEvent",
      "position": { "x": 80, "y": 240 },
      "width": 40,
      "height": 40,
      "next": ["submit_request"]
    },
    {
      "id": "submit_request",
      "name": "Submit Request",
      "type": "HumanTask",
      "position": { "x": 240, "y": 220 },
      "width": 120,
      "height": 60,
      "next": ["manager_review"],
      "config": {
        "assignee": "requester",
        "candidateGroups": "",
        "formId": "qaIntakeForm",
        "inputs": [
          { "targetName": "requestTitle", "type": "string", "source": "variable", "value": "requestTitle" },
          { "targetName": "amount", "type": "number", "source": "variable", "value": "amount" },
          { "targetName": "priority", "type": "string", "source": "variable", "value": "priority" }
        ],
        "outputs": [
          { "target": "variable", "sourceName": "requestTitle", "type": "string", "value": "requestTitle" },
          { "target": "variable", "sourceName": "amount", "type": "number", "value": "amount" },
          { "target": "variable", "sourceName": "priority", "type": "string", "value": "priority" },
          { "target": "variable", "sourceName": "supportingDocument", "type": "string", "value": "supportingDocument" }
        ]
      }
    },
    {
      "id": "manager_review",
      "name": "Manager Review",
      "type": "HumanTask",
      "position": { "x": 440, "y": 220 },
      "width": 120,
      "height": 60,
      "next": ["approval_gateway"],
      "config": {
        "assignee": "manager",
        "candidateGroups": "MANAGERS",
        "formId": "qaManagerReview",
        "inputs": [
          { "targetName": "requestTitle", "type": "string", "source": "variable", "value": "requestTitle" },
          { "targetName": "amount", "type": "number", "source": "variable", "value": "amount" }
        ],
        "outputs": [
          { "target": "variable", "sourceName": "approved", "type": "boolean", "value": "approved" },
          { "target": "variable", "sourceName": "managerComment", "type": "string", "value": "managerComment" }
        ]
      }
    },
    {
      "id": "approval_gateway",
      "name": "Approved?",
      "type": "ExclusiveGateway",
      "position": { "x": 640, "y": 240 },
      "width": 40,
      "height": 40,
      "next": ["finance_review", "end_rejected"]
    },
    {
      "id": "finance_review",
      "name": "Finance Review",
      "type": "HumanTask",
      "position": { "x": 820, "y": 140 },
      "width": 120,
      "height": 60,
      "next": ["end_approved"],
      "config": {
        "assignee": "",
        "candidateGroups": "FINANCE,ADMIN",
        "formId": "qaFinanceReview",
        "inputs": [
          { "targetName": "amount", "type": "number", "source": "variable", "value": "amount" },
          { "targetName": "managerComment", "type": "string", "source": "variable", "value": "managerComment" },
          { "targetName": "approvedPdf", "type": "string", "source": "variable", "value": "supportingDocument" }
        ],
        "outputs": [
          { "target": "variable", "sourceName": "financeApproved", "type": "boolean", "value": "financeApproved" },
          { "target": "variable", "sourceName": "paymentMethod", "type": "string", "value": "paymentMethod" },
          { "target": "variable", "sourceName": "financeComment", "type": "string", "value": "financeComment" }
        ]
      }
    },
    {
      "id": "end_approved",
      "name": "Approved End",
      "type": "EndEvent",
      "position": { "x": 1040, "y": 160 },
      "width": 40,
      "height": 40,
      "next": []
    },
    {
      "id": "end_rejected",
      "name": "Rejected End",
      "type": "EndEvent",
      "position": { "x": 820, "y": 340 },
      "width": 40,
      "height": 40,
      "next": []
    }
  ],
  "flows": [
    { "from": "start", "to": "submit_request", "condition": null },
    { "from": "submit_request", "to": "manager_review", "condition": null },
    { "from": "manager_review", "to": "approval_gateway", "condition": null },
    { "from": "approval_gateway", "to": "finance_review", "condition": "${approved} == true" },
    { "from": "approval_gateway", "to": "end_rejected", "condition": "${approved} == false" },
    { "from": "finance_review", "to": "end_approved", "condition": null }
  ]
}
