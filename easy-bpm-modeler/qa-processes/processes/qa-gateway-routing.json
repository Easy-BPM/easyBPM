{
  "processId": "qa_gateway_routing",
  "processName": "QA Gateway Routing",
  "metadata": {
    "version": "1.0",
    "purpose": "QA for exclusive conditional routing and parallel fork/join synchronization."
  },
  "variables": [
    { "name": "priority", "type": "string", "initialValue": "HIGH" },
    { "name": "riskScore", "type": "number", "initialValue": "75" },
    { "name": "legalDone", "type": "boolean", "initialValue": "false" },
    { "name": "securityDone", "type": "boolean", "initialValue": "false" }
  ],
  "nodes": [
    { "id": "start", "name": "Start", "type": "StartEvent", "position": { "x": 80, "y": 260 }, "width": 40, "height": 40, "next": ["risk_gateway"] },
    { "id": "risk_gateway", "name": "High Risk?", "type": "ExclusiveGateway", "position": { "x": 240, "y": 260 }, "width": 40, "height": 40, "next": ["parallel_fork", "standard_review"] },
    {
      "id": "standard_review",
      "name": "Standard Review",
      "type": "HumanTask",
      "position": { "x": 420, "y": 360 },
      "width": 120,
      "height": 60,
      "next": ["end_standard"],
      "config": {
        "candidateGroups": "QA",
        "formId": "qaManagerReview",
        "inputs": [
          { "targetName": "priority", "type": "string", "source": "variable", "value": "priority" }
        ],
        "outputs": [
          { "target": "process", "sourceName": "approved", "type": "boolean", "value": "approved" }
        ]
      }
    },
    { "id": "parallel_fork", "name": "Parallel Checks", "type": "ParallelGateway", "position": { "x": 420, "y": 180 }, "width": 40, "height": 40, "next": ["legal_check", "security_check"] },
    {
      "id": "legal_check",
      "name": "Legal Check",
      "type": "HumanTask",
      "position": { "x": 620, "y": 100 },
      "width": 120,
      "height": 60,
      "next": ["parallel_join"],
      "config": {
        "candidateGroups": "LEGAL",
        "formId": "qaManagerReview",
        "outputs": [
          { "target": "process", "sourceName": "legalDone", "type": "boolean", "value": "legalDone" }
        ]
      }
    },
    {
      "id": "security_check",
      "name": "Security Check",
      "type": "HumanTask",
      "position": { "x": 620, "y": 260 },
      "width": 120,
      "height": 60,
      "next": ["parallel_join"],
      "config": {
        "candidateGroups": "SECURITY",
        "formId": "qaManagerReview",
        "outputs": [
          { "target": "process", "sourceName": "securityDone", "type": "boolean", "value": "securityDone" }
        ]
      }
    },
    { "id": "parallel_join", "name": "Join Checks", "type": "ParallelGateway", "position": { "x": 840, "y": 180 }, "width": 40, "height": 40, "next": ["end_high_risk"] },
    { "id": "end_high_risk", "name": "High Risk End", "type": "EndEvent", "position": { "x": 1020, "y": 180 }, "width": 40, "height": 40, "next": [] },
    { "id": "end_standard", "name": "Standard End", "type": "EndEvent", "position": { "x": 620, "y": 380 }, "width": 40, "height": 40, "next": [] }
  ],
  "flows": [
    { "from": "start", "to": "risk_gateway", "condition": null },
    { "from": "risk_gateway", "to": "parallel_fork", "condition": "priority == 'HIGH' || riskScore >= 70" },
    { "from": "risk_gateway", "to": "standard_review", "condition": "priority != 'HIGH' && riskScore < 70" },
    { "from": "parallel_fork", "to": "legal_check", "condition": null },
    { "from": "parallel_fork", "to": "security_check", "condition": null },
    { "from": "legal_check", "to": "parallel_join", "condition": null },
    { "from": "security_check", "to": "parallel_join", "condition": null },
    { "from": "parallel_join", "to": "end_high_risk", "condition": null },
    { "from": "standard_review", "to": "end_standard", "condition": null }
  ]
}
