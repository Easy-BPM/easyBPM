{
  "processId": "qa_message_timer_events",
  "processName": "QA Message and Timer Events",
  "metadata": {
    "version": "1.0",
    "purpose": "Modeler QA for message start, intermediate catch/throw, payload mappings, and timer event configuration.",
    "backendDeployNote": "Current backend NodeType enum does not include MessageStartEvent, so use this as a modeler import/export QA asset unless backend support is added."
  },
  "variables": [
    { "name": "caseId", "type": "string", "initialValue": "CASE-1001" },
    { "name": "messagePayload", "type": "json", "initialValue": "{}" },
    { "name": "invoiceReceived", "type": "boolean", "initialValue": "false" },
    { "name": "timerStatus", "type": "string", "initialValue": "" }
  ],
  "nodes": [
    {
      "id": "message_start",
      "name": "Case Created Message",
      "type": "MessageStartEvent",
      "position": { "x": 80, "y": 240 },
      "width": 40,
      "height": 40,
      "next": ["wait_invoice"],
      "message": {
        "name": "qa.case.created",
        "correlationKeys": ["caseId"],
        "timeoutSeconds": null,
        "payload": [
          { "source": "variable", "sourceName": "payload", "sourceValue": "payload", "target": "variable", "targetVariable": "messagePayload", "type": "json", "value": "messagePayload" }
        ]
      },
      "properties": {
        "messageName": "qa.case.created",
        "correlationKey": "caseId",
        "timeoutSeconds": null
      }
    },
    {
      "id": "wait_invoice",
      "name": "Wait Invoice",
      "type": "MessageIntermediateCatchEvent",
      "position": { "x": 280, "y": 220 },
      "width": 120,
      "height": 60,
      "next": ["sla_timer"],
      "message": {
        "name": "qa.invoice.received",
        "correlationKeys": ["caseId"],
        "timeoutSeconds": 300,
        "payload": [
          { "source": "variable", "sourceName": "invoiceReceived", "sourceValue": "invoiceReceived", "target": "variable", "targetVariable": "invoiceReceived", "type": "boolean", "value": "invoiceReceived" }
        ]
      }
    },
    {
      "id": "sla_timer",
      "name": "SLA Timer",
      "type": "TimerEvent",
      "position": { "x": 500, "y": 240 },
      "width": 40,
      "height": 40,
      "next": ["throw_status"],
      "properties": {
        "timeoutSeconds": 60
      }
    },
    {
      "id": "throw_status",
      "name": "Throw Status",
      "type": "MessageIntermediateThrowEvent",
      "position": { "x": 700, "y": 220 },
      "width": 120,
      "height": 60,
      "next": ["end"],
      "message": {
        "name": "qa.case.status.changed",
        "correlationKeys": ["caseId"],
        "timeoutSeconds": null,
        "payload": [
          { "targetName": "invoiceReceived", "type": "boolean", "source": "variable", "value": "invoiceReceived" },
          { "targetName": "timerStatus", "type": "string", "source": "static", "value": "SLA_TIMER_PASSED" }
        ]
      }
    },
    { "id": "end", "name": "End", "type": "EndEvent", "position": { "x": 920, "y": 240 }, "width": 40, "height": 40, "next": [] }
  ],
  "flows": [
    { "from": "message_start", "to": "wait_invoice", "condition": null },
    { "from": "wait_invoice", "to": "sla_timer", "condition": null },
    { "from": "sla_timer", "to": "throw_status", "condition": null },
    { "from": "throw_status", "to": "end", "condition": null }
  ]
}
