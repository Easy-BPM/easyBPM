{
  "processId": "qa_api_components",
  "processName": "QA API Components",
  "metadata": {
    "version": "1.0",
    "purpose": "QA for API task properties, auth variants, body serialization, and output mappings."
  },
  "variables": [
    { "name": "customerId", "type": "string", "initialValue": "CUST-1001" },
    { "name": "caseId", "type": "string", "initialValue": "CASE-1001" },
    { "name": "bearerStatus", "type": "string", "initialValue": "" },
    { "name": "basicStatus", "type": "string", "initialValue": "" },
    { "name": "apiKeyStatus", "type": "string", "initialValue": "" },
    { "name": "apiPayload", "type": "json", "initialValue": "{}" }
  ],
  "nodes": [
    { "id": "start", "name": "Start", "type": "StartEvent", "position": { "x": 80, "y": 260 }, "width": 40, "height": 40, "next": ["api_bearer_get"] },
    {
      "id": "api_bearer_get",
      "name": "Bearer GET",
      "type": "APITask",
      "position": { "x": 260, "y": 160 },
      "width": 120,
      "height": 60,
      "next": ["api_basic_get"],
      "properties": {
        "url": "https://httpbin.org/get?customerId={{customerId}}",
        "method": "GET",
        "auth": {
          "type": "bearer",
          "ref": "QA_PARTNER_BEARER_TOKEN"
        },
        "outputs": [
          { "source": "static", "sourceValue": "BEARER_OK", "sourceName": "status", "type": "string", "target": "variable", "targetVariable": "bearerStatus", "value": "bearerStatus" }
        ]
      }
    },
    {
      "id": "api_basic_get",
      "name": "Basic GET",
      "type": "APITask",
      "position": { "x": 460, "y": 260 },
      "width": 120,
      "height": 60,
      "next": ["api_apikey_post"],
      "properties": {
        "url": "https://httpbin.org/basic-auth/qa/qa",
        "method": "GET",
        "auth": {
          "type": "basic",
          "ref": "QA_BASIC_CREDENTIALS"
        },
        "outputs": [
          { "source": "static", "sourceValue": "BASIC_OK", "sourceName": "status", "type": "string", "target": "variable", "targetVariable": "basicStatus", "value": "basicStatus" }
        ]
      }
    },
    {
      "id": "api_apikey_post",
      "name": "API Key POST",
      "type": "APITask",
      "position": { "x": 660, "y": 360 },
      "width": 120,
      "height": 60,
      "next": ["end"],
      "properties": {
        "url": "https://httpbin.org/post",
        "method": "POST",
        "auth": {
          "type": "apikey",
          "ref": "QA_PARTNER_API_KEY",
          "in": "header",
          "key": "X-QA-API-Key"
        },
        "body": {
          "caseId": "{{caseId}}",
          "customerId": "{{customerId}}",
          "source": "easy-bpm-modeler-qa"
        },
        "outputs": [
          { "source": "static", "sourceValue": "APIKEY_OK", "sourceName": "status", "type": "string", "target": "variable", "targetVariable": "apiKeyStatus", "value": "apiKeyStatus" },
          { "source": "static", "sourceValue": "{\"ok\":true}", "sourceName": "payload", "type": "json", "target": "variable", "targetVariable": "apiPayload", "value": "apiPayload" }
        ]
      }
    },
    { "id": "end", "name": "End", "type": "EndEvent", "position": { "x": 880, "y": 260 }, "width": 40, "height": 40, "next": [] }
  ],
  "flows": [
    { "from": "start", "to": "api_bearer_get", "condition": null },
    { "from": "api_bearer_get", "to": "api_basic_get", "condition": null },
    { "from": "api_basic_get", "to": "api_apikey_post", "condition": null },
    { "from": "api_apikey_post", "to": "end", "condition": null }
  ]
}
