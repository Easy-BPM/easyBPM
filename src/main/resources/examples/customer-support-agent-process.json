{
  "processId": "customer-support-agent-process",
  "processName": "Customer Support Agent Process",
  "description": "Example BPM process that captures a complaint, invokes an Agent Process, and asks a human to review the agent decision.",
  "variables": [
    {
      "name": "customerId",
      "type": "string",
      "initialValue": "CUST-1001"
    },
    {
      "name": "complaintText",
      "type": "string",
      "initialValue": "Customer reports that the replacement product arrived damaged and asks for a refund."
    },
    {
      "name": "refundAmount",
      "type": "number",
      "initialValue": 650
    },
    {
      "name": "agentDecision",
      "type": "string",
      "initialValue": ""
    },
    {
      "name": "agentResponseText",
      "type": "string",
      "initialValue": ""
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "StartEvent",
      "name": "Start",
      "next": [
        "capture-complaint"
      ]
    },
    {
      "id": "capture-complaint",
      "type": "HumanTask",
      "name": "Capture Complaint",
      "next": [
        "invoke-resolution-agent"
      ],
      "config": {
        "formId": null,
        "assignee": "support.agent",
        "candidateGroups": "SUPPORT",
        "inputs": [],
        "outputs": [
          {
            "target": "variable",
            "sourceName": "complaintText",
            "type": "string",
            "value": "complaintText"
          },
          {
            "target": "variable",
            "sourceName": "refundAmount",
            "type": "number",
            "value": "refundAmount"
          }
        ]
      }
    },
    {
      "id": "invoke-resolution-agent",
      "type": "AgentProcessCall",
      "name": "Invoke Resolution Agent",
      "next": [
        "review-agent-decision"
      ],
      "config": {
        "agentProcessKey": "customer-support-resolution",
        "goalOverride": "Investigate the customer complaint and recommend the next resolution action.",
        "waitForCompletion": true,
        "timeoutDays": 7,
        "inputs": [
          {
            "targetName": "customerId",
            "type": "string",
            "source": "variable",
            "value": "customerId"
          },
          {
            "targetName": "complaintText",
            "type": "string",
            "source": "variable",
            "value": "complaintText"
          },
          {
            "targetName": "refundAmount",
            "type": "number",
            "source": "variable",
            "value": "refundAmount"
          }
        ],
        "outputs": [
          {
            "source": "variable",
            "sourceValue": "decision",
            "type": "string",
            "targetVariable": "agentDecision"
          },
          {
            "source": "variable",
            "sourceValue": "responseText",
            "type": "string",
            "targetVariable": "agentResponseText"
          }
        ]
      }
    },
    {
      "id": "review-agent-decision",
      "type": "HumanTask",
      "name": "Review Agent Decision",
      "next": [
        "end"
      ],
      "config": {
        "formId": null,
        "assignee": "support.manager",
        "candidateGroups": "SUPPORT_MANAGERS",
        "inputs": [
          {
            "targetName": "agentDecision",
            "type": "string",
            "source": "variable",
            "value": "agentDecision"
          },
          {
            "targetName": "agentResponseText",
            "type": "string",
            "source": "variable",
            "value": "agentResponseText"
          }
        ],
        "outputs": []
      }
    },
    {
      "id": "end",
      "type": "EndEvent",
      "name": "End"
    }
  ],
  "flows": [
    {
      "from": "start",
      "to": "capture-complaint",
      "condition": null
    },
    {
      "from": "capture-complaint",
      "to": "invoke-resolution-agent",
      "condition": null
    },
    {
      "from": "invoke-resolution-agent",
      "to": "review-agent-decision",
      "condition": null
    },
    {
      "from": "review-agent-decision",
      "to": "end",
      "condition": null
    }
  ]
}
