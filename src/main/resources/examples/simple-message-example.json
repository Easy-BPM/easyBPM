{
  "processId": "simple-message-example",
  "name": "Simple Message Event Example",
  "description": "Minimal example showing message event usage",
  "version": 1,
  "variables": [
    {
      "name": "orderId",
      "initialValue": "ORD-123"
    },
    {
      "name": "instanceNumber",
      "initialValue": "1"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "StartEvent",
      "name": "Start",
      "next": ["waitMessage"]
    },
    {
      "id": "waitMessage",
      "type": "MessageEvent",
      "name": "Receive Message",
      "properties": {
        "messageName": "MyMessage",
        "correlationKey": "${orderId}-${instanceNumber}",
        "timeoutSeconds": 1800
      },
      "next": ["end"]
    },
    {
      "id": "end",
      "type": "EndEvent",
      "name": "End"
    }
  ],
  "flows": [
    {
      "source": "start",
      "target": "waitMessage"
    },
    {
      "source": "waitMessage",
      "target": "end"
    }
  ]
}
