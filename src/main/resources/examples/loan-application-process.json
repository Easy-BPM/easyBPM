{
  "processId": "loan-application-process",
  "name": "Loan Application Approval Process",
  "description": "Multi-step loan approval with async message notifications",
  "version": 1,
  "variables": [
    {
      "name": "applicationId",
      "initialValue": "LOAN-APP-001",
      "type": "string"
    },
    {
      "name": "customerId",
      "initialValue": "CUST-001",
      "type": "string"
    },
    {
      "name": "loanAmount",
      "initialValue": 50000,
      "type": "number"
    },
    {
      "name": "creditScore",
      "initialValue": null,
      "type": "number"
    },
    {
      "name": "approvalStatus",
      "initialValue": null,
      "type": "string"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "type": "StartEvent",
      "name": "Application Submitted",
      "next": ["validateApplication"]
    },
    {
      "id": "validateApplication",
      "type": "ServiceTask",
      "name": "Validate Application Data",
      "properties": {
        "serviceName": "loan-service",
        "operation": "validateApplication",
        "inputs": [
          {
            "targetName": "applicationId",
            "source": "variable",
            "value": "applicationId"
          },
          {
            "targetName": "customerId",
            "source": "variable",
            "value": "customerId"
          }
        ]
      },
      "next": ["waitForCreditCheck"]
    },
    {
      "id": "waitForCreditCheck",
      "type": "MessageEvent",
      "name": "Wait for Credit Check Results",
      "description": "Waits for credit bureau to send credit score",
      "properties": {
        "messageName": "CreditCheckComplete",
        "correlationKey": "${customerId}-${applicationId}",
        "timeoutSeconds": 7200
      },
      "next": ["evaluateCredit"]
    },
    {
      "id": "evaluateCredit",
      "type": "ExclusiveGateway",
      "name": "Evaluate Credit Score",
      "next": ["approveOrDeny"]
    },
    {
      "id": "approveOrDeny",
      "type": "ExclusiveGateway",
      "name": "Credit Score Decision",
      "next": []
    },
    {
      "id": "approveLoan",
      "type": "ServiceTask",
      "name": "Approve Loan Application",
      "properties": {
        "serviceName": "loan-service",
        "operation": "approveLoan"
      },
      "next": ["notifyApproval"]
    },
    {
      "id": "notifyApproval",
      "type": "ServiceTask",
      "name": "Send Approval Notification",
      "properties": {
        "serviceName": "notification-service",
        "operation": "sendApprovalEmail"
      },
      "next": ["waitForDocuments"]
    },
    {
      "id": "waitForDocuments",
      "type": "MessageEvent",
      "name": "Wait for Document Submission",
      "description": "Customer submits required documents",
      "properties": {
        "messageName": "DocumentsSubmitted",
        "correlationKey": "${applicationId}",
        "timeoutSeconds": 604800
      },
      "next": ["verifyDocuments"]
    },
    {
      "id": "verifyDocuments",
      "type": "ServiceTask",
      "name": "Verify Documents",
      "properties": {
        "serviceName": "document-service",
        "operation": "verifyDocuments"
      },
      "next": ["end"]
    },
    {
      "id": "denyLoan",
      "type": "ServiceTask",
      "name": "Deny Loan Application",
      "properties": {
        "serviceName": "loan-service",
        "operation": "denyLoan"
      },
      "next": ["notifyDenial"]
    },
    {
      "id": "notifyDenial",
      "type": "ServiceTask",
      "name": "Send Denial Notification",
      "properties": {
        "serviceName": "notification-service",
        "operation": "sendDenialEmail"
      },
      "next": ["end"]
    },
    {
      "id": "end",
      "type": "EndEvent",
      "name": "Process Complete"
    }
  ],
  "flows": [
    {
      "source": "start",
      "target": "validateApplication"
    },
    {
      "source": "validateApplication",
      "target": "waitForCreditCheck"
    },
    {
      "source": "waitForCreditCheck",
      "target": "evaluateCredit"
    },
    {
      "source": "evaluateCredit",
      "target": "approveOrDeny"
    },
    {
      "source": "approveOrDeny",
      "target": "approveLoan",
      "condition": "${creditScore >= 700}"
    },
    {
      "source": "approveOrDeny",
      "target": "denyLoan"
    },
    {
      "source": "approveLoan",
      "target": "notifyApproval"
    },
    {
      "source": "notifyApproval",
      "target": "waitForDocuments"
    },
    {
      "source": "waitForDocuments",
      "target": "verifyDocuments"
    },
    {
      "source": "verifyDocuments",
      "target": "end"
    },
    {
      "source": "denyLoan",
      "target": "notifyDenial"
    },
    {
      "source": "notifyDenial",
      "target": "end"
    }
  ]
}
